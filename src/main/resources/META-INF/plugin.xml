<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <id>dev.thymian.intellijplugin</id>
  <name>Thymian</name>
  <vendor>qupaya technologies GmbH</vendor>
  <category>Microservices</category>

  <dependencies>
    <plugin id="com.intellij.modules.platform"/>
    <plugin id="com.intellij.modules.microservices"/>
    <plugin id="com.intellij.swagger"/>
    <module name="intellij.libraries.ktor.client"/>
    <module name="intellij.microservices.ui"/>
  </dependencies>

  <resource-bundle>messages.ThymianBundle</resource-bundle>

  <actions>
    <action id="ThymianEndpointsRunCheckAction"
            class="dev.thymian.intellijplugin.endpoints.ThymianEndpointsRunCheckAction"
            icon="dev.thymian.intellijplugin.ThymianIcons.Action">
      <add-to-group group-id="EndpointsActions.ContextMenu"/>
    </action>
  </actions>

  <extensions defaultExtensionNs="com.intellij">
    <microservices.endpointsSidePanelProvider
        implementation="dev.thymian.intellijplugin.endpoints.ThymianEndpointsSidePanel$Provider"/>

    <!-- Run -->
    <configurationType implementation="dev.thymian.intellijplugin.run.ThymianRunConfigurationType"/>

    <!-- Settings -->
    <applicationConfigurable
        instance="dev.thymian.intellijplugin.settings.ThymianSettingsConfigurable"
        id="dev.thymian.intellijplugin.settings"
        bundle="messages.ThymianBundle"
        key="title"
        parentId="tools"/>
  </extensions>
</idea-plugin>
